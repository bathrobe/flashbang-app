    "title": "Why Athenian Democracy Matters"
  },
  "atoms": [
    {
      "id": "f11da4c5-e6a4-4d2c-a2cd-df5cc95f7ac5",
      "sentence": "Athenian democracy rested on two pillars: direct political participation and equality before the law, including trial by a jury of one's peers.",
      "blurb": "The political pillar meant citizens voted on decisions themselves, with no representatives in between. The legal pillar meant one law for every citizen, applied by juries of ordinary citizens.",
      "quote": {
        "text": "The political base was the right of direct participation in the decision-making process. The legal base was equality before the law and the right to be judged by a jury of your peers. These were the twin pillars of Athenian democracy.",
        "timestamp": "00:06:00"
      },
      "transcriptRef": "transcripts/01-why-athenian-democracy-matters.md [00:06:00, 00:29:01]",
